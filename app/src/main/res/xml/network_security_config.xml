<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- IPTV streams often use http:// URLs. This is kept for channel coverage in internal builds. -->
    <!-- Revisit before public store distribution because global cleartext traffic weakens transport security. -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">iptv-org.github.io</domain>
        <domain includeSubdomains="true">gitee.io</domain>
    </domain-config>
    <!-- Add additional HTTP playlist/EPG hosts here if needed -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
